<?xml version="1.0" encoding="utf-8"?>
<!--
  KimyasalCizim: IIS yapilandirmasi (chemdraw.maege.tr, IIS 10).
  Apache karsiligi ayni klasordeki .htaccess; IIS onu okumaz, Apache de bunu.
  Vite her derlemede bu dosyayi dist/ icine kopyalar.

  Paylasimli hostingte bazi bolumler sunucu duzeyinde kilitli olabilir; o
  durumda site "500 Internal Server Error" verir. Oyle olursa once rewrite
  bolumunu silip deneyin (URL Rewrite modulu kurulu olmayabilir).
-->
<configuration>
  <system.webServer>

    <!--
      Ust klasorden miras gelen ASP.NET Core isleyicisini kaldir.
      IIS yapilandirmayi ust klasorlerden devralir. Bu site maege.tr'nin
      (Blazor Server) altinda ya da onunla ayni uygulama havuzunda
      durursa, aspNetCore isleyicisi buraya da gecer ve IIS bu klasoru
      ikinci bir ASP.NET Core uygulamasi sanar. Ayni havuzda iki in-process
      uygulama olamaz (HTTP 500.35); Blazor sitesi ayaga kalkamaz.
      KimyasalCizim saf statik bir site, bu isleyiciye ihtiyaci yok.
      Kaldirilacak isleyici yoksa remove zararsizdir.
    -->
    <handlers>
      <remove name="aspNetCore" />
    </handlers>

    <!--
      IIS tanimadigi uzantidaki dosyalari sunmaz, dosya dursa bile 404 doner.
      .webmanifest varsayilan olarak tanimli degil ve manifest olmadan tarayici
      "Yukle" secenegini hic gostermez.
      Once remove: eslem sunucuda zaten tanimliysa ikinci kez eklemek
      "yinelenen giris" hatasiyla 500 verir. Remove tanimsizsa zararsizdir.
    -->
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
    </staticContent>

    <!-- Statik sikistirma; WASM icin sunucu duzeyinde izin de gerekebilir. -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <!--
      HTTPS'e yonlendirme. Service worker yalniz guvenli baglamda calisir;
      http ile gelen ziyaretci uygulamayi kuramaz. URL Rewrite modulu gerekir.
    -->
    <rewrite>
      <rules>
        <rule name="HTTPS yonlendirmesi" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>

  <!--
    sw.js onbelleklenirse yuklenen yeni surum kullaniciya hic ulasmaz ve
    ortada bir hata da gorunmez. Manifest ve sayfa da her seferinde dogrulansin.
  -->
  <location path="sw.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="manifest.webmanifest">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- assets/ altindaki dosyalarin adi icerik hash'i tasir: kalici onbellek. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
